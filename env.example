# ====================================
# Configuración de Variables de Entorno
# ====================================
# Copia este archivo como .env y completa los valores

# PostgreSQL
DB_NAME=agente_ia_db
DB_USER=postgres
DB_PASSWORD=rootpassword
DB_PORT=5432

# IA (Ollama local)
AI_OLLAMA_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3

# Encriptación de credenciales (cambiar en producción)
ENCRYPTION_MASTER_KEY=agenteia256bitkeychangemeinprod!

# Whisper API (OpenAI) - para transcripción de audio
WHISPER_API_KEY=

# OpenAI Embeddings - para RAG vectorial
EMBEDDINGS_API_KEY=

# WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=agenteia_verify_token

# Debounce de mensajes (milisegundos)
DEBOUNCE_WINDOW_MS=3500

# Simulación de tipeo
TYPING_ENABLED=true
TYPING_WPS=8
TYPING_MAX_DELAY=6
