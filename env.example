# ======================================================
# Variables de entorno para agente-ia-local
# Copia este archivo a .env y ajusta los valores.
# ======================================================

# ===== Base de datos (PostgreSQL) =====
DB_NAME=agente_ia_db
DB_USER=postgres
DB_PASSWORD=rootpassword
DB_PORT=5432
# JDBC URL usada por Spring Boot (en Docker apunta al servicio db)
DB_URL=jdbc:postgresql://localhost:5432/agente_ia_db

# ===== IA (Ollama) =====
AI_OLLAMA_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3

# ===== Producción (HTTPS / Nginx) =====
# Dominio del VPS sobre el que se emitirá el certificado SSL
DOMAIN=midominio.com
